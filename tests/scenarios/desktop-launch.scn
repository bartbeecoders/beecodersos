# The mouse starts programs and works inside their windows: buttons on the
# desktop (Terminal, Files, Notes, from 100,6), a click on an entry of the
# file manager.
@usb kbd mouse
$ layout us
$ mkdir /aaa
@screenshot 1920x1080 pixels 102,8=3a6ea5 100,6=1f3a5f 190,8=3a6ea5 254,8=3a6ea5 20,20=a8d0f0 184,10=a8d0f0
$ threads
!~ desktop

# The pointer starts in the middle (960,540). A click on "Terminal".
@mouse -840 -524
@button left down
@button left up
@screenshot 1920x1080 pixels 300,36=3a6ea5 1500,78=8a9bb0
$ threads
~ terminal   (waiting|ready)

# "Files": the file manager on the root folder, at 64,64. Its list starts
# at 70,94 with the status line; the entries are aaa/, system/, welcome.txt.
@mouse 80 0
@button left down
@button left up
@screenshot 1920x1080 pixels 400,68=3a6ea5 300,36=8a9bb0 600,100=aaaaaa
$ threads
~ files      (waiting|ready)
# The bar is on the first entry (blue, 0000aa). A click on the third moves it there.
@screenshot 1920x1080 pixels 600,116=0000aa 600,148=000000
@mouse -50 138
@button left down
@button left up
@screenshot 1920x1080 pixels 600,116=000000 600,148=0000aa
$ threads
!~ editor
# A second click on it opens the file in the editor, at 96,96.
@button left down
@button left up
@screenshot 1920x1080 pixels 400,100=3a6ea5 400,68=8a9bb0
$ threads
~ editor     (waiting|ready)

# "Notes": the editor on notes.txt in the home folder, the fourth window (128,128).
@mouse 120 -138
@button left down
@button left up
@screenshot 1920x1080 pixels 500,132=3a6ea5 400,100=8a9bb0
@keys shift+h i ctrl+s
$ sleep 1
$ cat /notes.txt
~ ^Hi$
# With four extra windows open a button does nothing more.
@mouse -160 0
@button left down
@button left up
$ sleep 1
@screenshot 1920x1080 pixels 500,132=3a6ea5
