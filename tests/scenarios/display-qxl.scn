# The QXL card (what vm1 has) takes the same driver, and `mode=` on the
# kernel command line chooses the resolution at boot.
@vga qxl
@args mode=1024x768 desktop=off
$ display
driver: bochs
mode: 1024x768, 32 bits per pixel
text: 128x48 characters (8x16 font, automatic)
@screenshot 1024x768 text
$ display mode 1920x1080
mode: 1920x1080, 32 bits per pixel
@screenshot 1920x1080 text
